    "apiProfile": {
      "schemaVersion": 1,
      "profileId": "synthetic-count",
      "description": "本地测试接口；本配置说明调用方式，不规定范围外输入的错误状态或格式。",
      "routes": [
        {
          "method": "POST",
          "pathTemplate": "/classify",
          "description": "JSON 请求 count；范围内整数输入成功时 HTTP 200，JSON 响应 flag 为布尔值。",
          "successStatus": 200,
          "requestExample": {
            "count": 0
          },
          "responseExample": {
            "flag": false
          }
        }
      ],
      "isolationRules": []
    },
    "expected": {
      "coverage": {
        "input": "planned",
        "branch": "planned"
      },
      "inputDomainOnly": {
        "field": "count",
        "type": "integer"
      },
      "steps": [
        {
          "body": {
            "count": 36
          },
          "status": 200,
          "pointer": "/flag",
          "equals": false
        },
        {
          "body": {
            "count": 37
          },
          "status": 200,
          "pointer": "/flag",
          "equals": true
        }
      ]
    }
  },
