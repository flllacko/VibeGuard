  {
    "id": "integer-domain",
    "requirements": [
      {
        "id": "input",
        "text": "提供 HTTP 接口，接收一个整数 count。"
      },
      {
        "id": "branch",
        "text": "count 不小于 37 时返回 JSON {\"flag\":true}，小于 37 时返回 {\"flag\":false}。"
      }
